# Neon — aifestwebsite (AWS US East 2 / Ohio)
# Copy to .env.local and fill from: neon link / neon deploy (or Neon Console)

# Postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production

# Object storage (S3-compatible) — gallery media
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET_NAME=gallery

# Public media base = {AWS_ENDPOINT_URL_S3}/gallery  (no trailing slash)
# Bucket keys are edition folders: 2025/, 2026/, shared/
# App paths /media/2025/... rewrite to this base.
NEXT_PUBLIC_MEDIA_BASE_URL=
